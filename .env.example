# Database
DATABASE_URL="postgresql://financial_hub:financial_hub@localhost:5432/financial_hub?schema=public"

# Auth session signing secret (dev only — rotate in production)
AUTH_SECRET="replace-with-a-long-random-string"

# Reporting currency
DEFAULT_REPORTING_CURRENCY="USD"

# --- Phase 2: Google integration ---
# OAuth 2.0 client (from Google Cloud Console → Credentials). NEVER expose the
# secret to the browser. Authorized redirect URI must be:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL of this app, used to build the OAuth redirect URI.
APP_URL="http://localhost:3000"

# The master spreadsheet to sync (the long ID in the sheet's URL). Optional —
# it can also be set from the Settings page after connecting.
GOOGLE_SHEETS_SPREADSHEET_ID=""

# 32-byte key (base64 or hex) used to encrypt stored Google OAuth tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Comma-separated emails granted ADMIN on first Google login (bootstrap).
# Everyone else defaults to EMPLOYEE and can be elevated by an admin.
ADMIN_EMAILS=""
